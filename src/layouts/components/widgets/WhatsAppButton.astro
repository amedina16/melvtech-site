---
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
import config from ".astro/config.generated.json";

const t = await useTranslations(Astro.currentLocale as string);
const number = String(config.settings.contactInfo.whatsapp || "").replace(
  /\D/g,
  "",
);
const label = t("whatsapp.label");
const url = number
  ? `https://wa.me/${number}?text=${encodeURIComponent(t("whatsapp.message"))}`
  : "";
---

{
  url && (
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={label}
      title={label}
      class="whatsapp-button fixed right-5 bottom-5 z-100 flex size-14 items-center justify-center rounded-full text-white shadow-lg transition duration-300 hover:scale-110">
      <svg
        viewBox="0 0 32 32"
        class="size-8"
        fill="currentColor"
        aria-hidden="true">
        <path d="M16.002 3C9.38 3 4 8.376 4 14.995c0 2.113.553 4.176 1.6 5.99L4 29l8.2-1.568a12 12 0 0 0 3.8.62h.002C22.62 28.052 28 22.676 28 16.057 28 9.438 22.62 3 16.002 3Zm0 21.94h-.002a9.93 9.93 0 0 1-3.386-.598l-.243-.092-4.867.93.96-4.74-.158-.25a9.92 9.92 0 0 1-1.52-5.27c0-5.47 4.46-9.92 9.94-9.92 2.65 0 5.14 1.03 7.01 2.9a9.84 9.84 0 0 1 2.9 7.02c0 5.47-4.46 10.02-9.636 10.02Zm5.45-7.43c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
      </svg>
    </a>
  )
}

<style>
  .whatsapp-button {
    background-color: #25d366;
  }
  .whatsapp-button:hover {
    background-color: #1ebe5a;
  }
</style>
