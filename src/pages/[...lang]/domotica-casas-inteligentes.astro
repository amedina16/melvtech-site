---
import LandingDomotica from "@/layouts/components/landing/LandingDomotica.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import * as data from "../../data/landing-domotica";

// Español: /domotica-casas-inteligentes/. La versión en inglés vive en
// /en/smart-home-monterrey/ (ver PATH_ALIASES en i18nUtils.ts).
export function getStaticPaths() {
  return generatePaths().filter((p) => !p.params.lang);
}
---

<LandingDomotica data={data} />
